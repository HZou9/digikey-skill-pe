# DigiKey API (shared with digikey-skill)
# Get credentials at: https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_USE_SANDBOX=true
DIGIKEY_MOCK_MODE=auto

# Nexar API (for symbol/footprint download)
# Register free at: https://nexar.com/api
# Create an app → get Client ID + Secret
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# SnapMagic API (optional, for additional symbol sources)
# Request at: https://www.snapeda.com/get-api/
SNAPMAGIC_API_KEY=
